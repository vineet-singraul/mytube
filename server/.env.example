# MongoDB connection string.
# Local testing ke liye: mongodb://127.0.0.1:27017/youtube_app
# Cloud deployment (Render/Railway) ke liye: MongoDB Atlas ka free (M0) cluster banao
# aur uska connection string yahan daalo, jaisे:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/youtube_app
MONGODB_URI=mongodb://127.0.0.1:27017/youtube_app

# Server port (cloud hosting platform apna khud ka PORT env var set kar deta hai,
# usi ko prefer kiya jaata hai).
PORT=5000

# Admin panel ko protect karne wali secret key (login/signup nahi, sirf ek shared password).
# Isse zaroor badal dena, default mat rakhna.
ADMIN_KEY=changeme123
