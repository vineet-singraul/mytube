# MongoDB connection string. Dono machines (admin aur offline) par local
# MongoDB use karna hai.
MONGODB_URI=mongodb://127.0.0.1:27017/youtube_app

# Server port
PORT=5000

# Admin panel ko protect karne wali secret key (login/signup nahi, sirf ek shared password).
# Isse zaroor badal dena, default mat rakhna.
ADMIN_KEY=changeme123

# Download hone wale video ki max height (pixels). Chhoti value = kam storage.
MAX_VIDEO_HEIGHT=480
